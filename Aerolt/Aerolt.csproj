<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <ImplicitUsings>false</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>9</LangVersion>
        <Configurations>Debug;Release;DebugOutDir</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Core" Version="5.4.19" />
        <PackageReference Include="Bubbet-ZioConfigFile" Version="1.0.0" />
        <PackageReference Include="Bubbet-ZioRiskOfOptions" Version="1.0.0" />
        <PackageReference Include="RiskOfRain2.GameLibs" Version="1.4.1-r.0" />
        <PackageReference Include="Rune580-Risk_Of_Options" Version="2.5.3" />
        <PackageReference Include="UniverseLib.Mono" Version="1.5.1" GeneratePathProperty="true" />
        <PackageReference Include="UnityEngine.Modules" Version="2019.4.26" />
        <PackageReference Include="Zio" Version="0.7.3" />
    </ItemGroup>

    <!-- Copy UniverseLib.Mono.dll next to Aerolt.dll in the build output so it ships with the mod. -->
    <Target Name="CopyUniverseLib" AfterTargets="Build">
        <Copy SourceFiles="$(PkgUniverseLib_Mono)\lib\net35\UniverseLib.Mono.dll"
              DestinationFolder="$(OutDir)"
              SkipUnchangedFiles="true" />
    </Target>
</Project>
